# ── Database (Local/Cloud) ──────────────────────────────────
# Use 'localhost' for local dev, 'db' for Docker, or your Cloud DB URL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=smartmeal
DB_POOL_SIZE=10

# ── JWT Authentication ──────────────────────────────────
# Generate a long random string for production
JWT_SECRET=change_me_to_something_secure
JWT_EXPIRY_HOURS=24

# ── Edamam Recipe API ──────────────────────────────────
# Get these at: https://developer.edamam.com/
EDAMAM_APP_ID=your_edamam_app_id
EDAMAM_APP_KEY=your_edamam_app_key

# ── Razorpay Payments ──────────────────────────────────
# Get these at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Twilio (Optional: for SMS notifications) ───────────
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_phone

# ── Google OAuth (Integrated) ──────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── CORS ───────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app
